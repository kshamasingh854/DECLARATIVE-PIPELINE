@Library("Shared") - 
pipeline{
    
    agent any
    
    stages{
        
        stage("Hello"){
            steps{
                script{
                    hello()
                }
            }
        }
        stage("Code"){
          steps{
              echo "This is cloning the code"
              git url: "'https://github.com/kshamasingh854/django-notes-app.git", branch: "main"
              echo "Code cloning successfull"
          }  
        }
        stage("Build"){
           steps{
               echo "This is for build the code"
               sh "docker build -t notes-app:latest ."
               sh "whoami"
           }     
        }
        stage("Push to docker hub"){
              steps{
                  echo "This is push the code"
                  withCredentials([usernamePassword('credentialsId': "docker-passwd", 
                  passwordVariable: "dockerHubPass", usernameVariable:"dockerHubUser")]){
                  sh "docker login -u ${env.dockerHubUser} -p ${env.dockerHubPass}"
                  sh "docker image tag notes-app:latest ${env.dockerHubUser}/notes-app:latest"
                  sh "docker push kshamasingh854/notes-app:latest"
                  }
              }  
        }
        stage("Deploy"){
            steps{
                echo "This is for Deploy the code"
            }    
        }
    }
}
